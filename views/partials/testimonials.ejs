<% if (testimonials && testimonials.length) { %>
<section class="section section--tight testimonials">
  <div class="container">
    <div class="testimonials__grid">
      <% testimonials.forEach(function(t, i){ %>
        <article class="testimonial testimonial--<%= t.accent || 'green' %> <%= i % 2 === 1 ? 'testimonial--reverse' : '' %>">
          <div class="testimonial__photo">
            <% if (t.image) { %>
              <img src="<%= t.image %>" alt="<%= t.name %>" loading="lazy" />
            <% } else { %>
              <div class="testimonial__photo-ph">
                <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
              </div>
            <% } %>
          </div>
          <div class="testimonial__content">
            <p class="testimonial__quote accent-<%= t.accent || 'green' %>">"<%= t.quote %>"</p>
            <p class="testimonial__name"><%= t.name %></p>
            <p class="testimonial__role"><%= t.role %></p>
            <% if (t.area) { %>
              <p class="testimonial__area"><%= t.area %></p>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
