<%- include('partials/head', { heading: 'Mensajes de contacto' }) %>

<p class="muted" style="margin-top:-12px;margin-bottom:20px;">Leads recibidos desde el formulario de contacto del sitio.</p>

<table>
  <thead>
    <tr><th>Fecha</th><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Asunto</th><th>Mensaje</th></tr>
  </thead>
  <tbody>
    <% if (!rows.length) { %>
      <tr><td colspan="6" class="muted">Aún no hay mensajes.</td></tr>
    <% } %>
    <% rows.forEach(function(r){ %>
      <tr>
        <td class="muted" style="white-space:nowrap;"><%= r.created_at %></td>
        <td><%= r.name %></td>
        <td><a href="mailto:<%= r.email %>"><%= r.email %></a></td>
        <td><%= r.phone %></td>
        <td><%= r.subject %></td>
        <td><%= r.message %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/foot') %>
