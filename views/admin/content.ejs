<%- include('partials/head', { heading: 'Textos e imágenes' }) %>

<% if (saved) { %><div class="alert alert--ok">✓ Cambios guardados correctamente.</div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert--err"><%= error %></div><% } %>

<p class="muted" style="margin-top:-12px;margin-bottom:20px;">
  Todo el contenido textual y las imágenes de cada página. Edita y presiona <b>Guardar cambios</b> al final.
</p>

<form method="POST" action="/admin/content" enctype="multipart/form-data">
  <% Object.keys(groups).forEach(function(page){ %>
    <div class="panel">
      <h2><%= page %></h2>
      <p class="panel__hint">Campos de la página “<%= page %>”.</p>

      <% groups[page].forEach(function(item){ %>
        <div class="field">
          <label for="f-<%= item.key %>"><%= item.label || item.key %> <small class="muted">(<%= item.key %>)</small></label>

          <% if (item.type === 'textarea' || item.type === 'richtext') { %>
            <textarea id="f-<%= item.key %>" name="field[<%= item.key %>]" rows="3"><%= item.value %></textarea>

          <% } else if (item.type === 'image') { %>
            <input type="text" name="field[<%= item.key %>]" value="<%= item.value %>" placeholder="/uploads/imagen.jpg o pega una URL" />
            <input type="file" name="file[<%= item.key %>]" accept="image/*" />
            <% if (item.value) { %><img class="thumb" src="<%= item.value %>" alt="" /><% } %>
            <small>Sube un archivo o escribe una ruta/URL. El archivo subido tiene prioridad.</small>

          <% } else { %>
            <input id="f-<%= item.key %>" type="text" name="field[<%= item.key %>]" value="<%= item.value %>" />
          <% } %>
        </div>
      <% }) %>
    </div>
  <% }) %>

  <div class="actions-bar">
    <button class="btn" type="submit">💾 Guardar cambios</button>
    <a class="btn btn--ghost" href="/admin">Cancelar</a>
  </div>
</form>

<%- include('partials/foot') %>
