<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" href="/assets/Contigo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
<div class="admin">
  <aside class="sidebar">
    <div class="sidebar__logo">
      <img src="/assets/Logo Contigo.png" alt="conTIgo" />
      <span>Admin</span>
    </div>

    <div class="sidebar__group">General</div>
    <a href="/admin" class="<%= section === 'dashboard' ? 'is-active' : '' %>">📊 Panel</a>
    <a href="/admin/content" class="<%= section === 'content' ? 'is-active' : '' %>">✏️ Textos e imágenes</a>

    <div class="sidebar__group">Colecciones</div>
    <a href="/admin/collection/news_cards" class="<%= section === 'news_cards' ? 'is-active' : '' %>">🗂️ Tarjetas / Noticias</a>
    <a href="/admin/collection/testimonials" class="<%= section === 'testimonials' ? 'is-active' : '' %>">💬 Testimonios</a>
    <a href="/admin/collection/stats" class="<%= section === 'stats' ? 'is-active' : '' %>">📈 Estadísticas</a>
    <a href="/admin/collection/role_tabs" class="<%= section === 'role_tabs' ? 'is-active' : '' %>">🧩 Pestañas de roles</a>

    <div class="sidebar__group">Leads</div>
    <a href="/admin/submissions" class="<%= section === 'submissions' ? 'is-active' : '' %>">📥 Mensajes de contacto</a>

    <div class="sidebar__foot">
      <a href="/" target="_blank">🌐 Ver sitio</a>
      <a href="/admin/logout">🚪 Cerrar sesión</a>
    </div>
  </aside>

  <main class="main">
    <div class="topbar">
      <h1><%= typeof heading !== 'undefined' ? heading : title %></h1>
      <div>
        <span class="user"><%= currentUser ? currentUser.name : '' %></span>
      </div>
    </div>
