<%- include('partials/head', { heading: label }) %>

<div class="table-head">
  <p class="muted" style="margin:0;">Registros de “<%= label %>”. Arrastra el orden con el campo <b>sort</b>.</p>
  <a class="btn" href="/admin/collection/<%= table %>/new">+ Nuevo</a>
</div>

<table>
  <thead>
    <tr>
      <th>#</th>
      <% columns.filter(function(col){ return ['title','name','value','label','quote'].includes(col); }).slice(0,2).forEach(function(col){ %>
        <th><%= col %></th>
      <% }) %>
      <th>Orden</th>
      <th>Activo</th>
      <th style="text-align:right;">Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% if (!rows.length) { %>
      <tr><td colspan="6" class="muted">Sin registros todavía.</td></tr>
    <% } %>
    <% rows.forEach(function(row){ %>
      <tr>
        <td><%= row.id %></td>
        <% columns.filter(function(col){ return ['title','name','value','label','quote'].includes(col); }).slice(0,2).forEach(function(col){ %>
          <td><%= (row[col] || '').toString().slice(0, 70) %></td>
        <% }) %>
        <td><%= row.sort %></td>
        <td>
          <% if (row.active === undefined || row.active === 1) { %>
            <span class="tag" style="background:#e6f7f0;color:#0d7a52;">Sí</span>
          <% } else { %>
            <span class="tag" style="background:#fdecec;color:#c0392b;">No</span>
          <% } %>
        </td>
        <td>
          <div class="row-actions" style="justify-content:flex-end;">
            <a class="btn btn--ghost btn--sm" href="/admin/collection/<%= table %>/<%= row.id %>/edit">Editar</a>
            <form method="POST" action="/admin/collection/<%= table %>/<%= row.id %>/delete" onsubmit="return confirm('¿Eliminar este registro?');">
              <button class="btn btn--danger btn--sm" type="submit">Eliminar</button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/foot') %>
