<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" href="/assets/Contigo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <img src="/assets/Logo Contigo.png" alt="conTIgo" />
      <h1>Panel de administración</h1>

      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert--err"><%= error %></div><% } %>

      <form method="POST" action="/admin/login">
        <div class="field">
          <label for="email">Correo</label>
          <input id="email" name="email" type="email" required autofocus />
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" required />
        </div>
        <button class="btn-primary" type="submit">Ingresar</button>
      </form>

      <% if (typeof ssoEnabled !== 'undefined' && ssoEnabled) { %>
        <div class="divider">o</div>
        <a class="btn-ms" href="/auth/login">
          <svg width="18" height="18" viewBox="0 0 23 23"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
          Iniciar sesión con Microsoft
        </a>
      <% } else { %>
        <p class="muted" style="font-size:.78rem;text-align:center;margin-top:18px;">
          El inicio de sesión con Microsoft (SSO) está preparado y se activará al configurar Azure AD.
        </p>
      <% } %>
    </div>
  </div>
</body>
</html>
