<%- include('partials/head', { heading: (isNew ? 'Nuevo' : 'Editar') + ' · ' + label }) %>

<%
  function labelFor(col){
    var map = { title:'Título', body:'Texto', image:'Imagen', link:'Enlace', cta:'Texto del botón',
      accent:'Color', sort:'Orden', active:'Activo', page:'Página', quote:'Cita', name:'Nombre',
      role:'Cargo', value:'Valor', label:'Etiqueta', tags:'Etiquetas (separadas por |)' };
    return map[col] || col;
  }
%>

<% if (typeof error !== 'undefined' && error) { %><div class="alert alert--err"><%= error %></div><% } %>

<div class="panel" style="max-width:760px;">
  <form method="POST" action="/admin/collection/<%= table %><%= isNew ? '' : '/' + row.id %>" enctype="multipart/form-data">
    <% columns.forEach(function(col){ %>
      <% if (col === 'active') { %>
        <div class="field field--inline">
          <input type="checkbox" id="f-active" name="active" value="1" <%= (row.active === undefined || row.active === 1) ? 'checked' : '' %> />
          <label for="f-active" style="margin:0;">Activo (visible en el sitio)</label>
        </div>

      <% } else if (col === 'image' || col === 'image2') { %>
        <div class="field">
          <label><%= col === 'image2' ? 'Imagen secundaria' : 'Imagen' %></label>
          <input type="text" name="<%= col %>" value="<%= row[col] || '' %>" placeholder="/uploads/imagen.jpg o URL" />
          <input type="file" name="file[<%= col %>]" accept="image/*" />
          <% if (row[col]) { %><img class="thumb" src="<%= row[col] %>" alt="" /><% } %>
        </div>

      <% } else if (col === 'body' || col === 'quote' || col === 'tags') { %>
        <div class="field">
          <label><%= labelFor(col) %></label>
          <textarea name="<%= col %>" rows="<%= col === 'body' ? 4 : 2 %>"><%= row[col] || '' %></textarea>
        </div>

      <% } else if (col === 'accent') { %>
        <div class="field">
          <label>Color de acento</label>
          <select name="accent">
            <% ['blue','red','dark','green'].forEach(function(opt){ %>
              <option value="<%= opt %>" <%= row.accent === opt ? 'selected' : '' %>><%= opt %></option>
            <% }) %>
          </select>
        </div>

      <% } else if (col === 'page' && table === 'news_cards') { %>
        <div class="field">
          <label>Página</label>
          <select name="page">
            <option value="home" <%= row.page === 'home' ? 'selected' : '' %>>Home (tarjetas)</option>
            <option value="contigo-al-dia" <%= row.page === 'contigo-al-dia' ? 'selected' : '' %>>ConTIgo al día (noticias)</option>
          </select>
        </div>

      <% } else if (col === 'sort') { %>
        <div class="field">
          <label>Orden</label>
          <input type="number" name="sort" value="<%= row.sort || 0 %>" />
        </div>

      <% } else { %>
        <div class="field">
          <label><%= labelFor(col) %></label>
          <input type="text" name="<%= col %>" value="<%= row[col] || '' %>" />
        </div>
      <% } %>
    <% }) %>

    <div style="display:flex;gap:12px;margin-top:8px;">
      <button class="btn" type="submit">💾 Guardar</button>
      <a class="btn btn--ghost" href="/admin/collection/<%= table %>">Cancelar</a>
    </div>
  </form>
</div>

<%- include('partials/foot') %>
