<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section bg-lav">
  <div class="container">
    <div class="text-center" style="margin-bottom:34px;">
      <h1 class="section-title title-blue"><%= c['contacto.title'] || 'Contacto' %></h1>
      <p style="max-width:560px;margin:0 auto;color:var(--ink-soft);"><%= c['contacto.subtitle'] %></p>
    </div>

    <div class="form-card">
      <% if (sent) { %>
        <div class="alert alert--ok">✓ ¡Gracias! Hemos recibido tu mensaje y te responderemos a la brevedad.</div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert--err"><%= error %></div>
      <% } %>

      <form method="POST" action="/contacto">
        <% var f = (typeof form !== 'undefined' && form) ? form : {}; %>
        <div class="form-row">
          <div class="field">
            <label for="name">Nombre *</label>
            <input id="name" name="name" required value="<%= f.name || '' %>" />
          </div>
          <div class="field">
            <label for="email">Correo *</label>
            <input id="email" name="email" type="email" required value="<%= f.email || '' %>" />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="phone">Teléfono</label>
            <input id="phone" name="phone" value="<%= f.phone || '' %>" />
          </div>
          <div class="field">
            <label for="subject">Asunto</label>
            <input id="subject" name="subject" value="<%= f.subject || '' %>" />
          </div>
        </div>
        <div class="field">
          <label for="message">Mensaje *</label>
          <textarea id="message" name="message" rows="5" required><%= f.message || '' %></textarea>
        </div>
        <button type="submit" class="btn btn--blue btn--lg">Enviar mensaje <span class="plus">→</span></button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
