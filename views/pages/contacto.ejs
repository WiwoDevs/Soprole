<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section bg-lav">
  <div class="container">
    <div class="text-center" style="margin-bottom:34px;">
      <h1 class="section-title title-blue"><%= c['contacto.title'] || 'Contacto' %></h1>
      <p style="max-width:560px;margin:0 auto;color:var(--ink-soft);"><%= c['contacto.subtitle'] %></p>
    </div>

    <div class="form-card" style="text-align:center;">
      <h3 style="margin:0 0 6px;color:var(--ink);"><%= c['global.footer.title'] || 'Mesa de Ayuda' %></h3>
      <p style="color:var(--ink-soft);margin:0 0 24px;">Escríbenos o llámanos y te ayudamos a la brevedad.</p>

      <div class="contact-info">
        <p>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <a href="mailto:<%= c['global.footer.email'] %>"><%= c['global.footer.email'] || 'mesadeayuda@soprole.cl' %></a>
        </p>
        <p>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.74-1.05a2 2 0 0 1 2.11-.45c.74.34 1.53.57 2.34.7A2 2 0 0 1 22 16.92Z"/></svg>
          Teléfono: <%= c['global.footer.phone'] || '224365100' %>
          <% if (c['global.footer.anexo']) { %> · Anexo: <%= c['global.footer.anexo'] %><% } %>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-info p {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    color: var(--ink); font-size: 1.02rem; margin: 10px 0;
  }
  .contact-info a { color: var(--blue, #2746e6); text-decoration: none; }
  .contact-info a:hover { text-decoration: underline; }
</style>

<%- include('../partials/footer') %>
