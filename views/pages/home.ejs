<%- include('../partials/head') %>
<%- include('../partials/header') %>

<!-- HERO -->
<section class="hero">
  <!-- Panel de imagen a sangre (derecha): misma foto en dos capas que calzan perfecto -->
  <div class="hero__media <%= c['home.hero.image'] ? '' : 'hero__media--placeholder' %>">
    <% if (c['home.hero.image_bg']) { %>
      <img class="hero__media-bg" src="<%= c['home.hero.image_bg'] %>" alt="" aria-hidden="true" />
    <% } %>
    <% if (c['home.hero.image']) { %>
      <img class="hero__media-fg" src="<%= c['home.hero.image'] %>" alt="conTIgo Soprole" />
    <% } else { %>
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#8c93c9" stroke-width="1.2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
    <% } %>
    <% if (c['contigo.hero.tagline']) { %>
      <span class="hero__tagline"><%= c['contigo.hero.tagline'] %></span>
    <% } %>
  </div>

  <div class="container">
    <div class="hero__text">
      <h1 class="hero__title"><%- brandify(c['home.hero.title'] || 'Si funciona, es porque estamos conTIgo.') %></h1>
      <%
        var typedLines = [c['home.hero.line1'], c['home.hero.line2'], c['home.hero.line3']]
          .map(function (s) { return (s || '').trim(); }).filter(Boolean);
      %>
      <div class="hero__list">
        <p class="hero__typed" data-typed='<%= JSON.stringify(typedLines) %>'>
          <span class="hero__typed-text"><%= typedLines[0] || '' %></span><span class="hero__caret" aria-hidden="true"></span>
        </p>
      </div>
      <p class="hero__subtitle"><%= c['home.hero.subtitle'] %></p>
      <div class="hero__dots" aria-hidden="true">
        <span class="is-active"></span><span></span><span></span>
      </div>
    </div>
  </div>

  <svg class="hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,46 C300,104 560,8 800,40 C1020,70 1240,108 1440,56 L1440,90 L0,90 Z" fill="#ffffff"/>
  </svg>
</section>

<!-- TARJETAS DESTACADAS / NOTAS ÁREA TI -->
<section class="section bg-lav">
  <div class="container">
    <% if (c['contigo.news.title']) { %>
      <h2 class="section-title text-center title-blue" style="margin-bottom:30px;"><%= c['contigo.news.title'] %></h2>
    <% } %>
    <div class="carousel" data-carousel>
      <button class="carousel__btn carousel__btn--prev" type="button" data-carousel-prev aria-label="Ver anteriores">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="carousel__track" data-carousel-track>
      <%
        cards.forEach(function(card){
          var parts = String(card.body || '').split('\n\n').map(function(s){ return s.trim(); }).filter(Boolean);
          var lead = parts[0] || '';
          var rest = parts.slice(1);
          var hasFull = rest.length > 0;
      %>
        <article class="card">
          <div class="card__media <%= card.image ? '' : 'card__media--icon' %>">
            <% if (card.image) { %>
              <img src="<%= card.image %>" alt="<%= card.title %>" />
            <% } else { %>
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 10h18M8 18v2m8-2v2"/></svg>
            <% } %>
          </div>
          <div class="card__body">
            <h3 class="card__title accent-<%= card.accent %>"><%= card.title %></h3>
            <p class="card__text"><%= lead %></p>
            <% if (hasFull) { %>
              <button type="button" class="btn btn--<%= card.accent === 'dark' ? 'dark' : card.accent %> card__cta" data-note-open="note-<%= card.id %>">
                <%= card.cta || 'Leer más' %> <span class="plus">+</span>
              </button>
            <% } else if (card.link && card.link !== '#') { %>
              <a class="btn btn--<%= card.accent === 'dark' ? 'dark' : card.accent %> card__cta" href="<%= card.link %>">
                <%= card.cta || 'Leer más' %> <span class="plus">+</span>
              </a>
            <% } %>
          </div>

          <% if (hasFull) { %>
            <!-- Nota completa (oculta): la usa el modal de "Leer más" -->
            <template id="note-<%= card.id %>">
              <h2 class="note__title accent-<%= card.accent %>"><%= card.title %></h2>
              <% if (lead) { %><p class="note__lead"><%= lead %></p><% } %>
              <% rest.forEach(function(p){ %><p><%= p %></p><% }) %>
            </template>
          <% } %>
        </article>
      <% }) %>
      </div>

      <button class="carousel__btn carousel__btn--next" type="button" data-carousel-next aria-label="Ver siguientes">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>

      <div class="carousel__dots" data-carousel-dots aria-hidden="true"></div>
    </div>
  </div>
</section>

<%- include('../partials/testimonials') %>
<%- include('../partials/video') %>

<!-- Modal: nota completa ("Leer más") -->
<div class="modal" id="note-modal" hidden>
  <div class="modal__backdrop" data-note-close></div>
  <div class="modal__dialog" role="dialog" aria-modal="true" aria-label="Nota completa">
    <button class="modal__close" type="button" data-note-close aria-label="Cerrar">&times;</button>
    <div class="modal__content"></div>
  </div>
</div>

<%- include('../partials/footer') %>
