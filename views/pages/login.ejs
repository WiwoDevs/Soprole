<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Iniciar sesión · conTIgo Soprole' %></title>
  <link rel="icon" href="/assets/Contigo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="<%= versionar('/css/styles.css') %>" />
  <style>
    .login-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: var(--lav, #eef0fb);
    }
    .login-card {
      width: 100%;
      max-width: 400px;
      background: #fff;
      border-radius: 18px;
      box-shadow: 0 18px 50px rgba(20, 30, 80, .12);
      padding: 34px 30px;
      text-align: center;
    }
    .login-card__logo { height: 46px; margin-bottom: 18px; }
    .login-card h1 { font-size: 1.25rem; margin: 0 0 4px; color: var(--ink, #1c2340); }
    .login-card p.sub { color: var(--ink-soft, #6b7194); font-size: .9rem; margin: 0 0 22px; }
    .login-card .field { text-align: left; }
    .login-card .btn { width: 100%; justify-content: center; }
    .login-divider {
      display: flex; align-items: center; gap: 12px;
      color: var(--ink-soft, #6b7194); font-size: .8rem; margin: 20px 0;
    }
    .login-divider::before, .login-divider::after {
      content: ""; flex: 1; height: 1px; background: #e3e6f2;
    }
    .btn-ms {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      width: 100%; padding: 12px 16px; border-radius: 10px;
      border: 1px solid #d7dbec; background: #fff; color: #1c2340;
      font-weight: 600; font-size: .95rem; text-decoration: none; cursor: pointer;
      transition: background .15s ease, border-color .15s ease;
    }
    .btn-ms:hover { background: #f5f6fc; border-color: #c3c9e4; }
    .login-note { font-size: .78rem; color: var(--ink-soft, #6b7194); margin-top: 18px; }
  </style>
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <img class="login-card__logo" src="/assets/Logo Contigo.png" alt="conTIgo" />
      <h1>Acceso conTIgo</h1>
      <p class="sub">Sitio interno del equipo de TI de Soprole</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert--err"><%= error %></div>
      <% } %>

      <% if (typeof localEnabled === 'undefined' || localEnabled) { %>
        <form method="POST" action="/login">
          <div class="field">
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" required autofocus autocomplete="username" />
          </div>
          <div class="field">
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" />
          </div>
          <button class="btn btn--blue btn--lg" type="submit">Ingresar</button>
        </form>
      <% } %>

      <% if (typeof ssoEnabled !== 'undefined' && ssoEnabled) { %>
        <% if (typeof localEnabled === 'undefined' || localEnabled) { %>
          <div class="login-divider">o</div>
        <% } %>
        <a class="btn-ms" href="/auth/login">
          <svg width="18" height="18" viewBox="0 0 23 23" aria-hidden="true"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
          Iniciar sesión con Microsoft
        </a>
      <% } else { %>
        <p class="login-note">
          El inicio de sesión con Microsoft (SSO) está preparado y se activará al configurar Azure AD.
        </p>
      <% } %>
    </div>
  </div>
</body>
</html>
