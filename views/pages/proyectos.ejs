<%- include('../partials/head') %>
<%- include('../partials/header') %>

<!-- HERO banner -->
<%
  // Sin titulo, la imagen es una pieza grafica completa (trae su propio
  // titulo y textos): se muestra entera, sin recorte ni desenfoque, y sin
  // la onda inferior, que taparia el contenido de la pieza.
  var heroTitulo = (c['proyectos.hero.title'] || '').trim();
  var heroGrafico = !heroTitulo;
%>
<section class="hero-banner <%= heroGrafico ? 'hero-banner--grafico' : '' %>">
  <% if (c['proyectos.hero.image']) { %>
    <img class="hero-banner__img" src="<%= c['proyectos.hero.image'] %>"
         alt="Proyectos: el exito nace de la sinergia entre personas, procesos y tecnologias" />
  <% } %>

  <% if (!heroGrafico) { %>
    <div class="hero-banner__inner">
      <h1 class="hero-banner__title"><%= heroTitulo %></h1>
    </div>
    <svg class="hero-wave" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,52 C300,110 560,12 800,46 C1020,76 1240,116 1440,60 L1440,100 L0,100 Z" fill="#ffffff"/>
    </svg>
  <% } %>
</section>

<!-- Marco Metodológico -->
<section class="section bg-lav">
  <div class="container">
    <div class="marco">
      <div class="marco__media">
        <% if (c['proyectos.marco.image_bg']) { %>
          <img class="marco__media-bg" src="<%= c['proyectos.marco.image_bg'] %>" alt="" aria-hidden="true" />
        <% } %>
        <% if (c['proyectos.marco.image']) { %>
          <img class="marco__media-fg" src="<%= c['proyectos.marco.image'] %>" alt="Marco Metodológico" />
        <% } else { %>
          <div style="width:100%;height:100%;min-height:320px;display:grid;place-items:center;color:#9aa3d6;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 19V5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M14 3v5h5"/></svg>
          </div>
        <% } %>
      </div>
      <div class="marco__text-col">
        <h2 class="marco__title"><%= c['proyectos.marco.title'] || 'Marco Metodológico' %></h2>
        <p class="marco__text"><%= c['proyectos.marco.body'] %></p>
        <a class="btn btn--orange btn--lg" href="<%= c['proyectos.marco.link'] || '#' %>">
          <%= c['proyectos.marco.button'] || 'Descarga aquí' %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Nuestro Team (carrusel de fotos del equipo) -->
<section class="section">
  <div class="container">
    <h2 class="section-title text-center title-red"><%= c['proyectos.capacitacion.title'] || 'Nuestro Team' %></h2>
    <div class="capacita" style="margin-top:30px;">
      <p class="capacita__text"><%= c['proyectos.capacitacion.body'] %></p>

      <% if (typeof teamSlides !== 'undefined' && teamSlides.length) { %>
        <div class="carousel team-carousel" data-carousel>
          <button class="carousel__btn carousel__btn--prev" type="button" data-carousel-prev aria-label="Foto anterior">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>

          <div class="carousel__track" data-carousel-track>
            <% teamSlides.forEach(function(slide){ %>
              <% if (slide.video) { %>
                <%
                  // El numero sale del nombre del archivo, no del indice del
                  // slide: los primeros slides son fotos y el conteo no calza.
                  var mColab = String(slide.video).split('colaborador-')[1];
                  var etiquetaColaborador = mColab
                    ? 'Testimonio del colaborador ' + parseInt(mColab, 10)
                    : 'Testimonio de un colaborador';
                %>
                <%# Video del colaborador. Va SIN src: lo asigna el JS cuando
                    el slide entra en pantalla. Con 25 clips (mas de 300 MB),
                    cargarlos todos de entrada dejaria el sitio inutilizable.
                    'muted' es obligatorio: los navegadores bloquean la
                    reproduccion automatica con sonido. %>
                <figure class="team-slide team-slide--video">
                  <video data-team-video data-src="<%= slide.video %>"
                         muted playsinline preload="none" controls
                         aria-label="<%= etiquetaColaborador %>"></video>
                  <% if (slide.caption) { %>
                    <figcaption class="team-slide__caption"><%= slide.caption %></figcaption>
                  <% } %>
                </figure>
              <% } else if (slide.image) { %>
                <figure class="team-slide">
                  <img src="<%= slide.image %>" alt="<%= slide.caption || 'Equipo conTIgo' %>" loading="lazy" />
                  <% if (slide.caption) { %>
                    <figcaption class="team-slide__caption"><%= slide.caption %></figcaption>
                  <% } %>
                </figure>
              <% } %>
            <% }) %>
          </div>

          <button class="carousel__btn carousel__btn--next" type="button" data-carousel-next aria-label="Foto siguiente">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>

          <div class="carousel__dots" data-carousel-dots aria-hidden="true"></div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Cápsulas conTIgo (carrusel · preparadas para reproducir video) -->
<section class="section">
  <div class="container">
    <div class="text-center" style="margin-bottom:30px;">
      <h2 class="section-title title-blue"><%= c['proyectos.capsulas.title'] || 'Cápsulas conTIgo' %></h2>
      <% if (c['proyectos.capsulas.subtitle']) { %>
        <p style="max-width:640px;margin:0 auto;color:var(--ink-soft);"><%= c['proyectos.capsulas.subtitle'] %></p>
      <% } %>
    </div>

    <div class="capsules" data-tabs>
      <div class="capsules__nav">
        <button class="capsules__arrow" type="button" data-tab-prev aria-label="Cápsula anterior">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="tabs__nav">
          <% roleTabs.forEach(function(tab, i){ %>
            <button class="tab-btn <%= i === 0 ? 'is-active' : '' %>" data-tab="cap-<%= tab.id %>"><%= tab.label %></button>
          <% }) %>
        </div>
        <button class="capsules__arrow" type="button" data-tab-next aria-label="Cápsula siguiente">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>

      <% roleTabs.forEach(function(tab, i){ %>
        <div class="tab-panel capsule <%= i === 0 ? 'is-active' : '' %>" data-tab="cap-<%= tab.id %>">
          <div class="capsule__content">
            <h3 class="capsule__title"><%= tab.title %></h3>
            <p class="capsule__text"><%= tab.body %></p>
          </div>
          <div class="capsule__media">
            <% if (tab.link) { %>
              <!-- Con link definido: la miniatura lleva a la cápsula en Buk -->
              <a class="video video--link" href="<%= tab.link %>" target="_blank" rel="noopener"
                 aria-label="Ver la cápsula «<%= tab.title %>» en Buk"
                 <% if (tab.poster) { %>style="background-image:url('<%= tab.poster %>')"<% } %>>
                <% if (tab.poster) { %><img src="<%= tab.poster %>" alt="Cápsula: <%= tab.title %>" /><% } %>
                <span class="video__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="capsule__badge">Ver en Buk</span>
              </a>
            <% } else { %>
              <div class="video" data-video="<%= tab.video || '' %>" <% if (tab.poster) { %>style="background-image:url('<%= tab.poster %>')"<% } %>>
                <% if (tab.poster) { %><img src="<%= tab.poster %>" alt="Cápsula: <%= tab.title %>" /><% } %>
                <button class="video__play" type="button" aria-label="Reproducir cápsula">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </button>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Proyectos TI que impulsan el futuro -->
<section class="section bg-lav">
  <div class="container text-center">
    <h2 class="section-title title-blue"><%= c['proyectos.futuro.title'] || 'Proyectos TI que impulsan el futuro' %></h2>
    <p style="max-width:680px;margin:0 auto 44px;color:var(--ink-soft);"><%= c['proyectos.futuro.body'] %></p>
    <div class="stats">
      <% stats.forEach(function(s){ %>
        <div class="stat">
          <div class="stat__icon">
            <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="<%= s.accent === 'red' ? '#f04a26' : '#2563eb' %>" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </div>
          <div class="stat__value accent-<%= s.accent %>">
            <span class="stat__num" data-count-to="<%= s.value %>">0</span><span class="stat__plus">+</span>
          </div>
          <div class="stat__label"><%= s.label %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
