# Dependencias
node_modules/

# Variables de entorno (¡nunca commitear secretos!)
.env

# Base de datos local
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Archivos subidos desde el panel de administración
public/uploads/*
!public/uploads/.gitkeep
assets/public/uploads/*
!assets/public/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build estático y paquetes de despliegue
dist/
*.zip

# Medios pesados: el video se sirve desde /media (ver server.js) pero NUNCA
# entra al repositorio — un mp4 de cientos de MB queda para siempre en el
# historial de git y supera el límite por archivo de GitHub.
media/
