# ==========================================================================
#  conTIgo Soprole — variables de entorno
#  Copia este archivo como .env y completa los valores.
# ==========================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# Secreto para firmar las cookies de sesión (CÁMBIALO en producción)
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# --- Acceso local de respaldo (login del sitio) ---
# Protege TODO el sitio mientras no esté activo el SSO de Microsoft.
# En producción la contraseña por defecto se rechaza: define una propia.
ADMIN_EMAIL=admin@soprole.cl
ADMIN_PASSWORD=Cambiar.123

# ==========================================================================
#  AUTENTICACIÓN MICROSOFT (Azure AD / Entra ID) — SSO
#  Dejar listo para conectar. Mientras AUTH_MICROSOFT_ENABLED=false,
#  el sitio usa el login local de arriba.
#  Cuando Soprole entregue el registro de la aplicación, completar estos
#  valores y poner AUTH_MICROSOFT_ENABLED=true. No requiere cambios de código.
# ==========================================================================
AUTH_MICROSOFT_ENABLED=false

# ID de inquilino (Directory / tenant ID) de Soprole
AZURE_TENANT_ID=

# ID de la aplicación registrada (Application / client ID)
AZURE_CLIENT_ID=

# Secreto de cliente (Client secret) generado en el registro de la app
AZURE_CLIENT_SECRET=

# URI de redirección registrada en Azure (debe coincidir EXACTO)
# En local:    http://localhost:3000/auth/redirect
# En producción: https://TU-DOMINIO/auth/redirect
AZURE_REDIRECT_URI=http://localhost:3000/auth/redirect

# A dónde volver tras cerrar sesión
AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# Dominios de correo autorizados para entrar al panel (separados por coma).
# Deja vacío para permitir cualquier cuenta del tenant.
AUTH_ALLOWED_DOMAINS=soprole.cl

# ==========================================================================
#  Integraciones de medición (opcionales — se inyectan si tienen valor)
# ==========================================================================
GOOGLE_ANALYTICS_ID=
META_PIXEL_ID=
